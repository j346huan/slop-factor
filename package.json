{
  "name": "slop-factor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:admin": "tsc --noEmit && node --check admin-worker/public/app.js",
    "lint": "eslint .",
    "format": "prettier --check .github/workflows admin-worker data public src tests/frontend ADMIN_GUIDE.md astro.config.ts eslint.config.js package.json README.md tsconfig.json",
    "format:fix": "prettier --write .github/workflows admin-worker data public src tests/frontend ADMIN_GUIDE.md astro.config.ts eslint.config.js package.json README.md tsconfig.json",
    "test": "node --import tsx --test tests/frontend/*.test.ts",
    "validate:data": "python scripts/validate_approved.py"
  },
  "dependencies": {
    "astro": "^5.13.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "engines": {
    "node": ">=20"
  }
}

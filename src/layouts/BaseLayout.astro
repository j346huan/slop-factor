---
import { sitePath } from "@/lib/paths";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Slop Factor",
  description = "A reviewed data tracker for mathematics papers with explicit author disclosures of AI use.",
} = Astro.props;
const pageTitle = title === "Slop Factor" ? title : `${title} · Slop Factor`;
const adminUrl = import.meta.env.PUBLIC_ADMIN_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href={sitePath("favicon.svg")} type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner shell">
        <a class="wordmark" href={sitePath()} aria-label="Slop Factor home">
          <span class="wordmark__title">Slop Factor</span>
        </a>
        <nav aria-label="Primary navigation">
          <a href={sitePath()}>Papers</a>
          <a href={sitePath("methodology/")}>Methodology</a>
          <a href={sitePath("about/")}>About</a>
          {adminUrl && <a href={adminUrl}>Administrator</a>}
        </nav>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
